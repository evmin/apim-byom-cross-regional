<!--
  APIM backend policy stack — always-on element.

  Composed at deploy time by infra/modules/sc-model-plane.bicep:
    - authentication-managed-identity (acquires an AAD token using APIM's
      system-assigned MI; the token authenticates the backend hop to the
      SC Foundry / AOAI account)
    - (optional) llm-semantic-cache-store — inserted from backend-cache.xml when
      enableSemanticCache = true; intentionally NOT present in this file

  Placeholder tokens replaced via Bicep `replace()` in :
    {{BACKEND_AUDIENCE}}     -> 'https://cognitiveservices.azure.com'   (no trailing slash;
                                this is the resource URI APIM's MI requests a token for)

  The XML below is a fragment that goes inside the <backend> element of the
  assembled policy document.
-->
<fragment>
    <!-- forward-request is the only allowed element at global-scope <backend>.
         The MI token attachment moved to inbound (authentication-managed-identity)
         because the service-level <backend> section accepts a single policy. -->
    <forward-request buffer-request-body="true" />
</fragment>
